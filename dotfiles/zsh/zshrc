if [[ -x /opt/homebrew/bin/brew ]]; then
	eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
	eval "$(/usr/local/bin/brew shellenv)"
fi

export PATH="$HOME/.local/bin:$PATH"

if command -v brew >/dev/null 2>&1; then
	brew_prefix="$(brew --prefix)"
	[[ -d "$brew_prefix/opt/ruby/bin" ]] && export PATH="$brew_prefix/opt/ruby/bin:$PATH"
	if [[ -s "$brew_prefix/opt/nvm/nvm.sh" ]]; then
		export NVM_DIR="$HOME/.nvm"
		# shellcheck disable=SC1090
		source "$brew_prefix/opt/nvm/nvm.sh"
	fi
	vi_mode="$brew_prefix/opt/zsh-vi-mode/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh"
	[[ -s "$vi_mode" ]] && source "$vi_mode"
fi

export BUN_INSTALL="$HOME/.bun"
[[ -d "$BUN_INSTALL/bin" ]] && export PATH="$BUN_INSTALL/bin:$PATH"
[[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"

if command -v go >/dev/null 2>&1; then
	export PATH="$PATH:$(go env GOPATH)/bin"
fi

export UPSCOPE_DIR="$HOME/dev/upscope"
[[ -d "$UPSCOPE_DIR/bin" ]] && export PATH="$UPSCOPE_DIR/bin:$PATH"

parse_git_branch() {
	git branch 2> /dev/null | sed -n -e 's/^\* \(.*\)/[\1]/p'
}
COLOR_DEF='%f'
COLOR_USR='%F{243}'
COLOR_DIR='%F{197}'
COLOR_GIT='%F{39}'
NEWLINE=$'\n'
setopt PROMPT_SUBST
export PROMPT='${COLOR_USR}%n@%M ${COLOR_DIR}%d ${COLOR_GIT}$(parse_git_branch)${COLOR_DEF}${NEWLINE}%% '

alias vi=nvim
alias vim=nvim

# Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

# Editors
export EDITOR='nvim'

# History
export HISTSIZE=32768
export HISTFILESIZE="${HISTSIZE}"
export HISTCONTROL='ignoreboth'

# Encoding
export PYTHONIOENCODING='UTF-8'
export LANG='en_US.UTF-8'
export LC_ALL='en_US.UTF-8'

# Aliases
alias grep='grep --color=auto'
alias path='echo -e ${PATH//:/\\n}'

# macOS-specific
if [[ "$(uname)" == "Darwin" ]]; then
	alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
	alias localip="ipconfig getifaddr en0"
	alias flush="dscacheutil -flushcache && killall -HUP mDNSResponder"
	alias cleanup="find . -type f -name '*.DS_Store' -ls -delete"
	alias show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
	alias hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"
	alias afk="/System/Library/CoreServices/Menu\ Extras/User.menu/Contents/Resources/CGSession -suspend"
	alias c="tr -d '\n' | pbcopy"
fi

# Functions
mkd() { mkdir -p "$@" && cd "$_"; }
fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh
	else
		local arg=-sh
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@"
	else
		du $arg .[^.]* ./*
	fi
}
tre() { tree -aC -I '.git|node_modules' --dirsfirst "$@" | less -FRNX; }
digga() { dig +nocmd "$1" any +multiline +noall +answer; }
gz() {
	local origsize=$(wc -c < "$1")
	local gzipsize=$(gzip -c "$1" | wc -c)
	local ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l)
	printf "orig: %d bytes\n" "$origsize"
	printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio"
}

sr() { source "$HOME/.zshrc"; }
dev() { cd "$HOME/dev" || return; }
lrepo() { cd "$HOME/.local/share/licokit/repo" || return; }
dotfiles() { lrepo; }
claudeyolo() { claude --dangerously-skip-permissions "$@"; }
cddev() {
	local dir
	dir=$(find "$HOME/dev" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | fzf --height 40% --reverse) || return
	[[ -n "$dir" ]] && cd "$dir" || return
}

claude_memory_worker="$HOME/.claude/plugins/marketplaces/thedotmack/plugin/scripts/worker-service.cjs"
if [[ -x "$HOME/.bun/bin/bun" && -f "$claude_memory_worker" ]]; then
	alias claude-mem='"$HOME/.bun/bin/bun" "$HOME/.claude/plugins/marketplaces/thedotmack/plugin/scripts/worker-service.cjs"'
fi

export EDITOR=nvim
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^e' edit-command-line

[[ -f "$HOME/.config/zsh/local.zsh" ]] && source "$HOME/.config/zsh/local.zsh"
